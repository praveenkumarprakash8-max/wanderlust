<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wanderlust | Discover Your Next Destination</title>
    <link rel="stylesheet" href="/css/home.css" />
  </head>
  <body>
    <header class="navbar">
      <a href="/" class="brand">
        <span class="brand-icon">W</span>
        Wanderlust
      </a>

      <nav>
        <a href="#destinations">Destinations</a>
        <a href="#about">About</a>
        <a href="/login" class="login-link">Log in</a>
        <a href="/signup" class="signup-btn">Sign up</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">DISCOVER YOUR NEXT ADVENTURE</p>

          <h1>
            The world is waiting.
            <span>Go find your place.</span>
          </h1>

          <p class="description">
            Discover beautiful stays, explore extraordinary destinations and
            turn your next trip into an unforgettable story.
          </p>

          <div class="hero-actions">
            <a href="/signup" class="primary-btn">
              Get Started <span>↗</span>
            </a>
            <a href="#destinations" class="secondary-btn">
              Explore destinations
            </a>
          </div>

          <div class="trust-note">
            <span>✦</span> Your next unforgettable journey starts here.
          </div>
        </div>

        <div class="hero-image">
          <img
            src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1200&q=85"
            alt="Beautiful mountain destination"
          />
          <div class="image-card">
            <span class="image-card-icon">✦</span>
            <div>
              <strong>Find your somewhere</strong>
              <p>Your next story starts here.</p>
            </div>
          </div>
          <div class="image-label">EXPLORE BEYOND THE ORDINARY</div>
        </div>
      </section>

      <section class="destinations" id="destinations">
        <div>
          <p class="eyebrow">YOUR NEXT ESCAPE</p>
          <h2>Find your kind of adventure.</h2>
          <p>Mountains, coastlines and places worth discovering.</p>
        </div>

        <a href="/listings" class="browse-link">
          Browse all stays <span>→</span>
        </a>
      </section>

      <section class="bottom-cta" id="about">
        <h2>Your next journey starts with one click.</h2>
        <p>Sign in to discover places and explore available stays.</p>
        <a href="/login" class="primary-btn">Start exploring ↗</a>
      </section>
    </main>

    <footer>
      <a href="/" class="brand">Wanderlust.</a>
      <p>Find your place in the world.</p>
    </footer>
  </body>
</html>
