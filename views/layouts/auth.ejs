<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Wanderlust | Account</title>

    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
    />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Main CSS -->
    <!-- If your file is public/css/style.css, use /css/style.css -->
    <link rel="stylesheet" href="/style.css" />

    <!-- Rating CSS -->
    <link rel="stylesheet" href="/CSS/rating.css" />

    <!-- Authentication Layout CSS -->
    <style>
      html,
      body.auth-page {
        margin: 0;
        padding: 0;
        min-height: 0;
        height: auto;
      }

      body.auth-page {
        font-family: "Plus Jakarta Sans", sans-serif;
        background: #fff8f9;
        overflow-x: hidden;
      }

      body.auth-page main.auth-main {
        width: 100%;
        max-width: none;
        min-height: 0;
        height: auto;
        margin: 0;
        padding: 0;
      }

      /* Login page wrapper */
      body.auth-page .login-page {
        width: 100%;
        max-width: none;
        min-height: 0;
        height: auto;
        margin: 0 !important;
        padding: 24px 16px !important;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        box-sizing: border-box;
      }

      /* Login card sizing */
      body.auth-page .login-page .login-card {
        width: 100%;
        max-width: 480px;
        min-width: 0;
        min-height: 0;
        height: auto;
        margin: 0 auto;
        padding: 28px 32px !important;
        box-sizing: border-box;
        border-radius: 24px;
      }

      /* Prevent overflowing elements */
      body.auth-page .login-page * {
        box-sizing: border-box;
      }

      body.auth-page .login-page input,
      body.auth-page .login-page button {
        max-width: 100%;
      }

      /* Smaller screens */
      @media (max-width: 576px) {
        body.auth-page .login-page {
          padding: 12px !important;
        }

        body.auth-page .login-page .login-card {
          max-width: 100%;
          padding: 22px 18px !important;
          border-radius: 20px;
        }
      }
    </style>
  </head>

  <body class="auth-page">
    <main class="auth-main">
      <%- include("../includes/flash.ejs") %> <%- body %>
    </main>

    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Main JavaScript -->
    <script src="/JS/script.js"></script>
  </body>
</html>
