<% layout("/layouts/auth") %>

<style>
  * {
    box-sizing: border-box;
  }

  .verify-page {
    width: 100%;
    min-height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 12px;
    background: #fff;
  }

  .verify-card {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    padding: 26px 30px;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 18px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.07);
    text-align: center;
  }

  .verify-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(254, 66, 77, 0.1);
    color: #fe424d;
    font-size: 30px;
  }

  .verify-badge {
    display: inline-block;
    margin-bottom: 9px;
    padding: 5px 12px;
    border-radius: 30px;
    background: rgba(254, 66, 77, 0.1);
    color: #fe424d;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .verify-card h1 {
    margin: 0 0 8px;
    color: #222;
    font-size: 29px;
    font-weight: 700;
  }

  .verify-subtitle {
    max-width: 420px;
    margin: 0 auto 18px;
    color: #777;
    font-size: 14px;
    line-height: 1.6;
  }

  .verify-info {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
    padding: 15px;
    border: 1px solid #f1dadd;
    border-radius: 12px;
    background: #fff8f8;
    text-align: left;
  }

  .verify-info-icon {
    flex-shrink: 0;
    color: #fe424d;
    font-size: 22px;
  }

  .info-content h5 {
    margin: 0 0 5px;
    color: #333;
    font-size: 15px;
    font-weight: 700;
  }

  .info-content p {
    margin: 0;
    color: #777;
    font-size: 13px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .verify-tip {
    margin: 0 0 18px;
    color: #777;
    font-size: 12px;
    line-height: 1.5;
  }

  .verify-tip i {
    margin-right: 5px;
    color: #fe424d;
  }

  .verify-resend {
    padding-top: 15px;
    border-top: 1px solid #eee;
  }

  .verify-resend p {
    margin: 0 0 10px;
    color: #555;
    font-size: 13px;
  }

  .verify-input {
    width: 100%;
    height: 44px;
    margin-bottom: 10px;
    padding: 10px 13px;
    border: 1px solid #ddd;
    border-radius: 8px;
    outline: none;
    font-size: 14px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .verify-input:focus {
    border-color: #fe424d;
    box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.1);
  }

  .verify-button {
    width: 100%;
    min-height: 44px;
    border: none;
    border-radius: 8px;
    background: #fe424d;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .verify-button:hover {
    background: #e93642;
  }

  .verify-footer {
    margin-top: 16px;
  }

  .verify-login {
    display: inline-block;
    color: #fe424d;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .verify-login:hover {
    color: #e93642;
    text-decoration: underline;
  }

  .verify-copyright {
    margin-top: 13px;
    color: #999;
    font-size: 11px;
  }

  .verify-copyright i {
    margin-right: 4px;
    color: #fe424d;
  }

  @media (max-width: 576px) {
    .verify-page {
      padding: 12px 10px;
    }

    .verify-card {
      max-width: 100%;
      padding: 22px 17px;
      border-radius: 14px;
    }

    .verify-icon {
      width: 56px;
      height: 56px;
      margin-bottom: 10px;
      font-size: 26px;
    }

    .verify-badge {
      margin-bottom: 8px;
      font-size: 10px;
    }

    .verify-card h1 {
      font-size: 25px;
    }

    .verify-subtitle {
      margin-bottom: 15px;
      font-size: 13px;
    }

    .verify-info {
      gap: 9px;
      padding: 12px;
    }

    .info-content h5 {
      font-size: 14px;
    }

    .info-content p {
      font-size: 12px;
    }

    .verify-tip {
      margin-bottom: 15px;
      font-size: 11px;
    }

    .verify-resend {
      padding-top: 13px;
    }

    .verify-footer {
      margin-top: 14px;
    }
  }

  @media (max-width: 360px) {
    .verify-card {
      padding: 20px 13px;
    }

    .verify-card h1 {
      font-size: 23px;
    }
  }
</style>

<div class="verify-page">
  <div class="verify-card">
    <!-- Email Icon -->
    <div class="verify-icon">
      <i class="fa-regular fa-envelope"></i>
    </div>

    <div class="verify-badge">ACCOUNT SECURITY</div>

    <h1>Verify your email</h1>

    <p class="verify-subtitle">
      You're almost there! Please verify your email address to activate your
      account and enjoy a secure experience.
    </p>

    <!-- Check Inbox Information -->
    <div class="verify-info">
      <div class="verify-info-icon">
        <i class="fa-regular fa-paper-plane"></i>
      </div>

      <div class="info-content">
        <h5>Check your inbox</h5>
        <p>
          We've sent a verification link to your registered email address. Open
          the email and click the verification link to activate your account.
        </p>
      </div>
    </div>

    <!-- Spam Folder Tip -->
    <p class="verify-tip">
      <i class="fa-solid fa-circle-info"></i>
      Can't find the email? Please check your spam or promotions folder.
    </p>

    <!-- Resend Verification Form -->
    <div class="verify-resend">
      <p>Didn't receive the verification email?</p>

      <form action="/resend-verification" method="POST">
        <input
          type="email"
          name="email"
          class="verify-input"
          placeholder="Enter your email address"
          required
        />

        <button type="submit" class="verify-button">
          <i class="fa-solid fa-paper-plane me-2"></i>
          Resend Verification Email
        </button>
      </form>
    </div>

    <!-- Footer -->
    <div class="verify-footer">
      <a href="/login" class="verify-login">
        <i class="fa-solid fa-arrow-left me-1"></i>
        Back to Login
      </a>
    </div>

    <div class="verify-copyright">
      <i class="fa-solid fa-shield-halved"></i>
      Secure signup · Explore the world, one stay at a time.
    </div>
  </div>
</div>
