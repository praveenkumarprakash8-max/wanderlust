<% layout("/layouts/auth") %>

<div class="container verify-page">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="verify-card">
        <!-- Email Icon -->
        <div class="verify-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="42"
            height="42"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>

          <span class="verify-check">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m5 12 4 4L19 6"></path>
            </svg>
          </span>
        </div>

        <!-- Badge -->
        <span class="verify-badge">
          <span class="security-dot"></span>
          ACCOUNT SECURITY
        </span>

        <!-- Heading -->
        <h1>Verify your email</h1>

        <p class="verify-subtitle">
          You're just one step away from joining Wanderlust. Verify your email
          address to get started.
        </p>

        <!-- Instructions -->
        <div class="verify-info">
          <div class="info-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
          </div>

          <div class="info-content">
            <h5>Check your inbox</h5>
            <p>
              Open the verification email we sent you and click the verification
              link to activate your account.
            </p>
          </div>
        </div>

        <!-- Helpful Tip -->
        <div class="verify-tip">
          <span class="tip-icon">i</span>
          <span>
            Can't find the email? Check your Spam or Promotions folder.
          </span>
        </div>

        <!-- Resend Verification -->
        <div class="resend-section">
          <h5 class="resend-heading">Still haven't received the email?</h5>

          <form action="/resend-verification" method="POST">
            <div class="verify-input-wrap">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="19"
                height="19"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>

              <input
                type="email"
                name="email"
                placeholder="Enter your email address"
                autocomplete="email"
                class="form-control verify-input"
                aria-label="Email address"
                required
              />
            </div>

            <button type="submit" class="verify-button">
              Resend verification email
              <span aria-hidden="true">→</span>
            </button>
          </form>
        </div>

        <!-- Footer -->
        <div class="verify-footer">
          <a href="/login" class="back-login">
            <span>←</span>
            Back to Login
          </a>

          <span class="secure-label">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="4" y="10" width="16" height="11" rx="2"></rect>
              <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
            </svg>
            Secure signup
          </span>
        </div>
      </div>

      <p class="verify-copyright">Explore the world, one stay at a time.</p>
    </div>
  </div>
</div>

<style>
  .verify-page {
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 35px;
    padding-bottom: 35px;
    font-family: "Plus Jakarta Sans", Arial, sans-serif;
  }

  .verify-card {
    box-sizing: border-box;
    width: 100%;
    padding: 38px;
    background: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: 20px;
    box-shadow: 0 10px 32px rgba(35, 30, 40, 0.07);
  }

  /* Email Icon */
  .verify-icon {
    position: relative;
    width: 76px;
    height: 76px;
    margin: 0 auto 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    background: #fff0f0;
    color: #fe424d;
  }

  .verify-check {
    position: absolute;
    right: -5px;
    bottom: -5px;
    width: 27px;
    height: 27px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #fe424d;
    color: #fff;
  }

  /* Badge */
  .verify-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: fit-content;
    margin: 0 auto 17px;
    padding: 8px 15px;
    border-radius: 30px;
    background: #fff1f1;
    color: #fe424d;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.7px;
  }

  .security-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fe424d;
  }

  /* Heading */
  .verify-card h1 {
    margin: 0 0 14px;
    color: #222222;
    text-align: center;
    font-size: clamp(27px, 5vw, 36px);
    font-weight: 800;
    letter-spacing: -0.8px;
  }

  .verify-subtitle {
    max-width: 470px;
    margin: 0 auto 30px;
    color: #777777;
    text-align: center;
    font-size: 14px;
    line-height: 1.8;
  }

  /* Instructions */
  .verify-info {
    display: flex;
    align-items: flex-start;
    gap: 15px;
    padding: 20px;
    border: 1px solid #f0e5e5;
    border-radius: 14px;
    background: #fffafa;
  }

  .info-icon {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: #fff0f0;
    color: #fe424d;
  }

  .info-content h5 {
    margin: 2px 0 7px;
    color: #292929;
    font-size: 16px;
    font-weight: 800;
  }

  .info-content p {
    margin: 0;
    color: #777777;
    font-size: 13px;
    line-height: 1.8;
  }

  /* Tip */
  .verify-tip {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 19px 0 29px;
    color: #777777;
    font-size: 13px;
    line-height: 1.7;
  }

  .tip-icon {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
    border: 1px solid #fe424d;
    border-radius: 50%;
    color: #fe424d;
    font-size: 12px;
    font-weight: 700;
  }

  /* Resend Form */
  .resend-heading {
    margin: 0 0 14px;
    color: #292929;
    font-size: 15px;
    font-weight: 750;
  }

  .verify-input-wrap {
    position: relative;
    margin-bottom: 14px;
  }

  .verify-input-wrap svg {
    position: absolute;
    top: 50%;
    left: 15px;
    transform: translateY(-50%);
    color: #999999;
    pointer-events: none;
  }

  .verify-input {
    box-sizing: border-box;
    width: 100%;
    min-height: 52px;
    padding: 12px 15px 12px 44px;
    border: 1px solid #dedede;
    border-radius: 10px;
    background: #ffffff;
    color: #333333;
    font-family: inherit;
    font-size: 14px;
    box-shadow: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .verify-input:focus {
    border-color: #fe424d;
    box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.12);
  }

  .verify-input::placeholder {
    color: #999999;
  }

  /* Button */
  .verify-button {
    width: 100%;
    min-height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 18px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(135deg, #fe424d, #e83240);
    color: #ffffff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 750;
    cursor: pointer;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .verify-button:hover {
    color: #ffffff;
    background: linear-gradient(135deg, #ed3542, #d92735);
    box-shadow: 0 5px 15px rgba(254, 66, 77, 0.2);
    transform: translateY(-1px);
  }

  /* Footer */
  .verify-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 27px;
    padding-top: 20px;
    border-top: 1px solid #eeeeee;
  }

  .back-login {
    color: #333333;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .back-login:hover {
    color: #fe424d;
  }

  .back-login span {
    margin-right: 5px;
  }

  .secure-label {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #999999;
    font-size: 12px;
  }

  .verify-copyright {
    margin: 19px 0 0;
    color: #999999;
    font-size: 12px;
    text-align: center;
  }

  /* Accessibility */
  .verify-button:focus-visible,
  .back-login:focus-visible {
    outline: 3px solid rgba(254, 66, 77, 0.35);
    outline-offset: 3px;
  }

  /* Mobile */
  @media (max-width: 576px) {
    .verify-page {
      min-height: 80vh;
      padding: 25px 12px;
    }

    .verify-card {
      padding: 27px 20px;
      border-radius: 17px;
    }

    .verify-icon {
      width: 66px;
      height: 66px;
    }

    .verify-subtitle {
      font-size: 13px;
    }

    .verify-info {
      gap: 12px;
      padding: 15px;
    }

    .info-icon {
      width: 42px;
      height: 42px;
    }

    .info-content h5 {
      font-size: 15px;
    }

    .info-content p {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .verify-button,
    .verify-input {
      transition: none;
    }
  }
</style>
