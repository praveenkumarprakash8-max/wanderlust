<% layout("/layouts/auth") %>

<div class="verify-page">
  <div class="verify-card">
    <!-- Email Logo: SVG, independent of Font Awesome -->
    <div class="verify-icon" aria-label="Email verification">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="38"
        height="38"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        role="img"
        aria-label="Email icon"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="m3 7 9 6 9-6"></path>
      </svg>

      <span class="verify-check" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m5 12 4 4L19 6"></path>
        </svg>
      </span>
    </div>

    <!-- Account Security -->
    <span class="verify-badge">
      <span class="security-dot"></span>
      ACCOUNT SECURITY
    </span>

    <!-- Heading -->
    <h1>Verify your email</h1>

    <p class="verify-subtitle">
      You're just one step away from joining Wanderlust. Verify your email
      address to get started.
    </p>

    <!-- Email Instructions -->
    <div class="verify-info">
      <div class="info-icon" aria-hidden="true">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="23"
          height="23"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m3 7 9 6 9-6"></path>
        </svg>
      </div>

      <div>
        <h6>Check your inbox</h6>
        <p>
          Open the verification email we sent you and click the verification
          link to activate your account.
        </p>
      </div>
    </div>

    <!-- Helpful Tip -->
    <div class="verify-tip">
      <span class="tip-icon" aria-hidden="true">i</span>
      <span> Can't find the email? Check your Spam or Promotions folder. </span>
    </div>

    <!-- Resend Verification Email -->
    <div class="resend-section">
      <p class="resend-heading">Still haven't received the email?</p>

      <form action="/resend-verification" method="POST">
        <div class="verify-input-wrap">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>

          <input
            type="email"
            name="email"
            placeholder="Enter your email address"
            autocomplete="email"
            class="verify-input"
            aria-label="Email address"
            required
          />
        </div>

        <button type="submit" class="verify-button">
          Resend verification email
          <span aria-hidden="true">→</span>
        </button>
      </form>
    </div>

    <!-- Footer -->
    <div class="verify-footer">
      <a href="/login">
        <span aria-hidden="true">←</span>
        Back to Login
      </a>

      <span class="secure-label">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="4" y="10" width="16" height="11" rx="2"></rect>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
        </svg>
        Secure signup
      </span>
    </div>
  </div>

  <p class="verify-copyright">Explore the world, one stay at a time.</p>
</div>

<style>
  .verify-page {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    background: #f6f8fb;
    border-radius: 16px;
    font-family: "Plus Jakarta Sans", sans-serif;
  }

  /* Main Card */
  .verify-card {
    box-sizing: border-box;
    width: 100%;
    max-width: 510px;
    padding: 42px;
    background: #fff;
    border: 1px solid #e8edf2;
    border-radius: 22px;
    box-shadow: 0 18px 55px rgba(20, 35, 55, 0.08);
  }

  /* Email SVG Icon */
  .verify-icon {
    position: relative;
    width: 76px;
    height: 76px;
    margin: 0 auto 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 22px;
    background: #e8f7ee;
    color: #16834a;
  }

  .verify-icon > svg {
    display: block;
    width: 38px;
    height: 38px;
    color: #16834a;
    opacity: 1;
    visibility: visible;
  }

  .verify-check {
    position: absolute;
    right: -5px;
    bottom: -5px;
    width: 27px;
    height: 27px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid #fff;
    border-radius: 50%;
    background: #16834a;
    color: #fff;
  }

  .verify-check svg {
    display: block;
  }

  /* Account Security Badge */
  .verify-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: fit-content;
    margin: 0 auto 14px;
    padding: 7px 12px;
    border-radius: 30px;
    background: #f0f8f3;
    color: #187344;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.7px;
  }

  .security-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #16834a;
  }

  /* Heading */
  .verify-card h1 {
    margin: 0 0 14px;
    color: #172b3a;
    text-align: center;
    font-size: clamp(26px, 5vw, 32px);
    font-weight: 800;
    letter-spacing: -0.8px;
  }

  .verify-subtitle {
    max-width: 390px;
    margin: 0 auto 28px;
    color: #687787;
    text-align: center;
    font-size: 14px;
    line-height: 1.9;
  }

  /* Instructions */
  .verify-info {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px;
    border: 1px solid #e6eee9;
    border-radius: 14px;
    background: #fbfdfb;
  }

  .info-icon {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 11px;
    background: #e8f7ee;
    color: #16834a;
  }

  .info-icon svg {
    display: block;
  }

  .verify-info h6 {
    margin: 2px 0 6px;
    color: #243746;
    font-size: 14px;
    font-weight: 800;
  }

  .verify-info p {
    margin: 0;
    color: #6d7b88;
    font-size: 12px;
    line-height: 1.8;
  }

  /* Helpful Tip */
  .verify-tip {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    margin: 16px 0 28px;
    color: #697786;
    font-size: 12px;
    line-height: 1.8;
  }

  .tip-icon {
    flex-shrink: 0;
    width: 17px;
    height: 17px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    border: 1px solid #5685b5;
    border-radius: 50%;
    color: #5685b5;
    font-size: 11px;
    font-weight: 700;
  }

  /* Resend Form */
  .resend-heading {
    margin-bottom: 12px;
    color: #273746;
    font-size: 13px;
    font-weight: 750;
  }

  .verify-input-wrap {
    position: relative;
    margin-bottom: 13px;
  }

  .verify-input-wrap > svg {
    position: absolute;
    top: 50%;
    left: 15px;
    transform: translateY(-50%);
    color: #82909d;
    pointer-events: none;
  }

  .verify-input {
    box-sizing: border-box;
    width: 100%;
    min-height: 49px;
    padding: 12px 14px 12px 43px;
    border: 1px solid #dce3e9;
    border-radius: 10px;
    outline: none;
    color: #253746;
    background: #fff;
    font-family: inherit;
    font-size: 13px;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .verify-input::placeholder {
    color: #9aa5af;
  }

  .verify-input:focus {
    border-color: #238653;
    box-shadow: 0 0 0 3px rgba(35, 134, 83, 0.12);
  }

  /* Resend Button */
  .verify-button {
    box-sizing: border-box;
    width: 100%;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 18px;
    border: none;
    border-radius: 10px;
    background: #176b43;
    color: #fff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
    transition:
      background 0.2s,
      transform 0.2s;
  }

  .verify-button:hover {
    background: #105536;
    transform: translateY(-1px);
  }

  /* Footer */
  .verify-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid #edf0f3;
  }

  .verify-footer a {
    color: #176b43;
    font-size: 12px;
    font-weight: 750;
    text-decoration: none;
  }

  .verify-footer a:hover {
    text-decoration: underline;
  }

  .verify-footer a > span {
    margin-right: 6px;
  }

  .secure-label {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #98a2ad;
    font-size: 11px;
  }

  /* Bottom Text */
  .verify-copyright {
    margin: 20px 0 0;
    color: #96a1ad;
    font-size: 11px;
    text-align: center;
  }

  /* Mobile Responsive */
  @media (max-width: 480px) {
    .verify-page {
      min-height: 80vh;
      padding: 28px 8px;
    }

    .verify-card {
      padding: 28px 20px;
      border-radius: 17px;
    }

    .verify-icon {
      width: 66px;
      height: 66px;
    }

    .verify-icon > svg {
      width: 34px;
      height: 34px;
    }

    .verify-footer {
      align-items: flex-start;
    }
  }

  /* Accessibility */
  .verify-button:focus-visible,
  .verify-footer a:focus-visible {
    outline: 3px solid #83cba3;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .verify-button,
    .verify-input {
      transition: none;
    }
  }
</style>
