<% layout("/layouts/auth") %>

<div class="container py-5 auth-page">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
      <div class="card auth-card shadow-lg border-0">
        <div class="card-body p-4 p-md-5">
          <!-- Header icon -->
          <div class="auth-icon-wrap text-center mb-4">
            <div class="auth-icon">&#128273;</div>
          </div>

          <p class="auth-eyebrow text-center mb-2">ACCOUNT SECURITY</p>

          <h2 class="auth-title text-center mb-2">Create New Password</h2>

          <p class="auth-description text-center mb-4">
            Choose a strong password to keep your Wanderlust account secure.
          </p>

          <form
            id="resetPasswordForm"
            action="/reset-password/<%= encodeURIComponent(token) %>"
            method="POST"
          >
            <!-- New Password -->
            <div class="mb-4 auth-field">
              <label for="password" class="form-label fw-semibold">
                New Password
              </label>

              <div class="input-group auth-password-wrap">
                <input
                  type="password"
                  id="password"
                  name="password"
                  class="form-control auth-input"
                  placeholder="Enter new password"
                  minlength="8"
                  maxlength="128"
                  autocomplete="new-password"
                  aria-describedby="passwordHint"
                  required
                />

                <button
                  type="button"
                  class="btn auth-toggle"
                  id="togglePassword"
                  aria-label="Show new password"
                  aria-controls="password"
                  aria-pressed="false"
                >
                  Show
                </button>
              </div>

              <small id="passwordHint" class="auth-hint">
                Use 8–128 characters for your password.
              </small>
            </div>

            <!-- Confirm Password -->
            <div class="mb-4 auth-field">
              <label for="confirmPassword" class="form-label fw-semibold">
                Confirm New Password
              </label>

              <div class="input-group auth-password-wrap">
                <input
                  type="password"
                  id="confirmPassword"
                  name="confirmPassword"
                  class="form-control auth-input"
                  placeholder="Re-enter new password"
                  minlength="8"
                  maxlength="128"
                  autocomplete="new-password"
                  required
                />

                <button
                  type="button"
                  class="btn auth-toggle"
                  id="toggleConfirmPassword"
                  aria-label="Show confirm password"
                  aria-controls="confirmPassword"
                  aria-pressed="false"
                >
                  Show
                </button>
              </div>

              <div
                id="passwordMessage"
                class="auth-password-message"
                role="status"
                aria-live="polite"
              ></div>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              id="updatePasswordBtn"
              class="btn auth-primary-btn w-100"
            >
              Update Password
              <span aria-hidden="true">&rarr;</span>
            </button>
          </form>

          <!-- Back to login -->
          <div class="auth-divider"></div>

          <p class="text-center auth-back-text mb-0">
            Remember your password?
            <a href="/login" class="auth-back-link"> Back to Login </a>
          </p>

          <div class="auth-security-note text-center mt-4">
            <span aria-hidden="true">&#128274;</span>
            Your account security matters to us.
          </div>
        </div>
      </div>

      <p class="auth-bottom-text text-center mt-4">
        WANDERLUST <span>&bull;</span> YOUR NEXT JOURNEY STARTS HERE
      </p>
    </div>
  </div>
</div>

<style>
  /* Reset password page only */
  .auth-page {
    --auth-red: #fe424d;
    --auth-red-dark: #e93642;
    --auth-text: #252832;
    --auth-muted: #777e89;
    --auth-border: #e7e9ee;
    padding-top: 55px !important;
    padding-bottom: 45px !important;
  }

  .auth-page .auth-card {
    background: #fff;
    border: 1px solid #f0f1f4 !important;
    border-radius: 24px !important;
    overflow: hidden;
    box-shadow: 0 18px 55px rgba(37, 40, 50, 0.09) !important;
    transition: box-shadow 0.25s ease;
  }

  .auth-page .auth-card .card-body {
    padding: 40px !important;
  }

  .auth-icon-wrap {
    display: flex;
    justify-content: center;
  }

  .auth-page .auth-icon {
    display: flex;
    width: 68px;
    height: 68px;
    align-items: center;
    justify-content: center;
    border-radius: 21px;
    background: #fff0f1;
    color: var(--auth-red);
    font-size: 30px;
    box-shadow: 0 7px 20px rgba(254, 66, 77, 0.08);
  }

  .auth-page .auth-eyebrow {
    color: var(--auth-red);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2.2px;
  }

  .auth-page .auth-title {
    color: var(--auth-text);
    font-size: clamp(24px, 4vw, 29px);
    font-weight: 800;
    letter-spacing: -0.8px;
    line-height: 1.3;
  }

  .auth-page .auth-description {
    color: var(--auth-muted);
    font-size: 14px;
    line-height: 1.8;
  }

  .auth-page .auth-field .form-label {
    display: block;
    margin-bottom: 9px;
    color: #353945;
    font-size: 13px;
  }

  .auth-page .auth-password-wrap {
    display: flex;
    flex-wrap: nowrap;
    border: 1px solid var(--auth-border);
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .auth-page .auth-password-wrap:focus-within {
    border-color: var(--auth-red);
    box-shadow: 0 0 0 4px rgba(254, 66, 77, 0.09);
  }

  .auth-page .auth-input {
    min-width: 0;
    min-height: 49px;
    padding: 12px 14px;
    border: 0 !important;
    border-radius: 0 !important;
    background: #fff !important;
    color: var(--auth-text);
    font-size: 14px;
    box-shadow: none !important;
  }

  .auth-page .auth-input::placeholder {
    color: #a1a6b0;
  }

  .auth-page .auth-input:focus {
    outline: none;
    box-shadow: none !important;
  }

  .auth-page .auth-toggle {
    flex: 0 0 auto;
    min-width: 67px;
    border: 0 !important;
    border-left: 1px solid var(--auth-border) !important;
    border-radius: 0 !important;
    background: #fafbfc;
    color: #5e6470;
    font-size: 12px;
    font-weight: 700;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .auth-page .auth-toggle:hover {
    background: #fff0f1;
    color: var(--auth-red-dark);
  }

  .auth-page .auth-toggle:focus-visible,
  .auth-page .auth-primary-btn:focus-visible,
  .auth-page .auth-back-link:focus-visible {
    outline: 3px solid rgba(254, 66, 77, 0.35);
    outline-offset: 3px;
  }

  .auth-page .auth-hint {
    display: block;
    margin-top: 9px;
    color: #8b909b;
    font-size: 11px;
    line-height: 1.6;
  }

  .auth-page .auth-password-message {
    min-height: 0;
    margin-top: 8px;
    font-size: 12px;
    line-height: 1.5;
  }

  .auth-page .auth-password-message:empty {
    display: none;
  }

  .auth-page .auth-password-message.text-danger {
    color: #d92d3a !important;
  }

  .auth-page .auth-password-message.text-success {
    color: #198754 !important;
  }

  .auth-page .auth-primary-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 51px;
    padding: 13px 20px;
    border: 0;
    border-radius: 13px;
    background: var(--auth-red);
    color: #fff;
    font-size: 14px;
    font-weight: 750;
    box-shadow: 0 7px 17px rgba(254, 66, 77, 0.2);
    transition:
      background 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .auth-page .auth-primary-btn:hover:not(:disabled) {
    background: var(--auth-red-dark);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 10px 22px rgba(254, 66, 77, 0.25);
  }

  .auth-page .auth-primary-btn:disabled {
    cursor: not-allowed;
    opacity: 0.7;
    box-shadow: none;
  }

  .auth-page .auth-divider {
    height: 1px;
    margin: 25px 0 20px;
    background: #f0f1f4;
  }

  .auth-page .auth-back-text {
    color: var(--auth-muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .auth-page .auth-back-link {
    margin-left: 4px;
    color: var(--auth-red);
    font-weight: 750;
    text-decoration: none;
  }

  .auth-page .auth-back-link:hover {
    color: var(--auth-red-dark);
    text-decoration: underline;
  }

  .auth-page .auth-security-note {
    color: #969ba5;
    font-size: 11px;
    line-height: 1.7;
  }

  .auth-page .auth-security-note span {
    margin-right: 4px;
  }

  .auth-page .auth-bottom-text {
    color: #a1a6b0;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.8px;
  }

  .auth-page .auth-bottom-text span {
    padding: 0 4px;
    color: var(--auth-red);
  }

  @media (max-width: 575.98px) {
    .auth-page {
      padding-top: 28px !important;
      padding-bottom: 25px !important;
    }

    .auth-page .auth-card {
      border-radius: 19px !important;
    }

    .auth-page .auth-card .card-body {
      padding: 28px 22px !important;
    }

    .auth-page .auth-icon {
      width: 60px;
      height: 60px;
      border-radius: 18px;
      font-size: 27px;
    }

    .auth-page .auth-title {
      font-size: 24px;
    }

    .auth-page .auth-description {
      font-size: 13px;
    }
  }

  /* FIX: Reset Password page width and layout */

  .auth-page {
    display: block !important;
    width: 100%;
    box-sizing: border-box;
  }

  .auth-page > .row {
    display: flex;
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    justify-content: center;
  }

  .auth-page > .row > [class*="col-"] {
    min-width: 0;
  }

  .auth-page .auth-card {
    width: 100%;
    max-width: 490px;
    margin: 0 auto;
    padding: 0;
    box-sizing: border-box;
  }

  .auth-page .auth-card .card-body {
    width: 100%;
    padding: 32px !important;
    box-sizing: border-box;
  }

  .auth-page .auth-title,
  .auth-page .auth-eyebrow,
  .auth-page .auth-description {
    display: block;
    width: 100%;
    max-width: 100%;
    writing-mode: horizontal-tb !important;
    word-break: normal !important;
    overflow-wrap: normal !important;
    white-space: normal !important;
  }

  .auth-page .auth-password-wrap {
    width: 100%;
    min-width: 0;
  }

  .auth-page .auth-input {
    flex: 1 1 auto;
    width: 1%;
    min-width: 0;
  }

  .auth-page .auth-toggle {
    flex-shrink: 0;
  }

  @media (max-width: 575.98px) {
    .auth-page .auth-card .card-body {
      padding: 25px 20px !important;
    }
  }
</style>

<script>
  (() => {
    const form = document.getElementById("resetPasswordForm");
    const password = document.getElementById("password");
    const confirmPassword = document.getElementById("confirmPassword");
    const message = document.getElementById("passwordMessage");
    const submitButton = document.getElementById("updatePasswordBtn");

    const togglePassword = document.getElementById("togglePassword");
    const toggleConfirmPassword = document.getElementById(
      "toggleConfirmPassword",
    );

    if (
      !form ||
      !password ||
      !confirmPassword ||
      !message ||
      !submitButton ||
      !togglePassword ||
      !toggleConfirmPassword
    ) {
      return;
    }

    let submitting = false;

    function setupPasswordToggle(input, button, visibleLabel) {
      button.addEventListener("click", () => {
        const show = input.type === "password";

        input.type = show ? "text" : "password";
        button.textContent = show ? "Hide" : "Show";
        button.setAttribute(
          "aria-label",
          `${show ? "Hide" : "Show"} ${visibleLabel}`,
        );
        button.setAttribute("aria-pressed", String(show));
      });
    }

    setupPasswordToggle(password, togglePassword, "new password");
    setupPasswordToggle(
      confirmPassword,
      toggleConfirmPassword,
      "confirm password",
    );

    function checkPasswords() {
      if (!confirmPassword.value) {
        message.textContent = "";
        message.className = "auth-password-message";
        confirmPassword.setCustomValidity("");
        return true;
      }

      if (password.value !== confirmPassword.value) {
        message.textContent = "Passwords do not match.";
        message.className = "auth-password-message text-danger";
        confirmPassword.setCustomValidity("Passwords do not match.");
        return false;
      }

      message.textContent = "Passwords match.";
      message.className = "auth-password-message text-success";
      confirmPassword.setCustomValidity("");
      return true;
    }

    password.addEventListener("input", checkPasswords);
    confirmPassword.addEventListener("input", checkPasswords);

    form.addEventListener("submit", (event) => {
      if (submitting) {
        event.preventDefault();
        return;
      }

      if (!checkPasswords()) {
        event.preventDefault();
        confirmPassword.reportValidity();
        return;
      }

      if (!form.checkValidity()) {
        event.preventDefault();
        form.reportValidity();
        return;
      }

      submitting = true;
      submitButton.disabled = true;
      submitButton.textContent = "Updating Password...";
    });
  })();
</script>
