<% layout("/layouts/auth") -%>

<div class="container signup-page">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="signup-card">
        <!-- Back to Home -->
        <a href="/" class="signup-back" aria-label="Back to home">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            fill="currentColor"
            viewBox="0 0 16 16"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"
            />
          </svg>
          <span>Back</span>
        </a>

        <!-- Header -->
        <div class="signup-header">
          <div class="signup-icon">
            <i class="fa-regular fa-compass" aria-hidden="true"></i>
          </div>
          <p class="signup-eyebrow">START YOUR JOURNEY</p>
          <h1>Join Wanderlust</h1>
        </div>

        <!-- Signup Form -->
        <form
          action="/signup"
          method="POST"
          class="signup-form needs-validation"
          novalidate
        >
          <!-- Username -->
          <div class="signup-field">
            <label for="username">Username</label>
            <div class="signup-input-wrap">
              <i class="fa-regular fa-user" aria-hidden="true"></i>
              <input
                name="username"
                id="username"
                type="text"
                placeholder="Choose a username"
                autocomplete="username"
                required
              />
              <div class="invalid-feedback">Please enter a username.</div>
            </div>
          </div>

          <!-- Email -->
          <div class="signup-field">
            <label for="email">Email</label>
            <div class="signup-input-wrap">
              <i class="fa-regular fa-envelope" aria-hidden="true"></i>
              <input
                name="email"
                id="email"
                type="email"
                placeholder="you@example.com"
                autocomplete="email"
                required
              />
              <div class="invalid-feedback">Please enter a valid email.</div>
            </div>
          </div>

          <!-- Password -->
          <div class="signup-field">
            <label for="password">Password</label>

            <div class="signup-input-wrap">
              <i class="fa-solid fa-lock" aria-hidden="true"></i>

              <input
                name="password"
                id="password"
                type="password"
                placeholder="Create a password"
                autocomplete="new-password"
                required
              />

              <!-- Eye icon: same as login, without a box -->
              <button
                type="button"
                id="togglePassword"
                class="signup-toggle"
                aria-label="Show password"
                aria-controls="password"
                aria-pressed="false"
              >
                <i class="fa-regular fa-eye" aria-hidden="true"></i>
              </button>

              <div class="invalid-feedback">Please enter a password.</div>
            </div>
          </div>

          <!-- Create Account -->
          <button class="signup-submit" type="submit">
            <span>Create Account</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
        </form>

        <!-- Divider -->
        <div class="signup-divider">
          <span></span>
          <p>OR</p>
          <span></span>
        </div>

        <!-- Google Signup -->
        <a href="/auth/google" class="signup-google">
          <i class="fa-brands fa-google" aria-hidden="true"></i>
          <span>Continue with Google</span>
        </a>

        <!-- Login -->
        <div class="signup-login">
          <span>Already have an account?</span>
          <a href="/login">Login</a>
        </div>

        <!-- Security -->
        <div class="signup-security">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          <span>Your information is protected.</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* WANDERLUST SIGNUP PAGE */

  .signup-page,
  .signup-page * {
    box-sizing: border-box;
  }

  .signup-page {
    --signup-red: #fe424d;
    --signup-red-dark: #e8323e;
    --signup-text: #252832;
    --signup-muted: #818b9d;
    --signup-border: #dfe4ed;

    width: 100%;
    max-width: none;
    min-height: 0 !important;
    height: auto !important;
    margin: 0 !important;
    padding: 12px !important;

    display: flex;
    justify-content: center;
    align-items: flex-start;

    background:
      radial-gradient(
        ellipse at top left,
        rgba(254, 66, 77, 0.07),
        transparent 40%
      ),
      #fffdfd;
  }

  .signup-page > .row {
    width: 100%;
    margin: 0;
    justify-content: center;
  }

  .signup-page > .row > .col-12 {
    width: 100%;
    max-width: 424px;
    padding: 0;
    margin: 0 auto;
  }

  /* Card */
  .signup-page .signup-card {
    width: 100%;
    max-width: 400px;
    min-width: 0;
    min-height: 0;
    height: auto;
    margin: 0 auto;
    padding: 20px 24px;

    border: 1px solid #f0edf0;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 10px 32px rgba(35, 30, 40, 0.07);
  }

  /* Back link */
  .signup-page .signup-back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 12px;
    color: #596273;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .signup-page .signup-back:hover {
    color: var(--signup-red);
  }

  /* Header */
  .signup-page .signup-header {
    margin: 0 0 20px;
    text-align: center;
  }

  .signup-page .signup-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin: 0 auto 10px;
    border-radius: 50%;
    background: #fff0f1;
    color: var(--signup-red);
  }

  .signup-page .signup-icon i {
    font-size: 23px;
  }

  .signup-page .signup-eyebrow {
    margin: 0 0 6px;
    color: var(--signup-red);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .signup-page .signup-header h1 {
    margin: 0;
    color: var(--signup-text);
    font-size: 27px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.6px;
  }

  /* Form fields */
  .signup-page .signup-field {
    margin-bottom: 13px;
  }

  .signup-page .signup-field label {
    display: block;
    margin-bottom: 6px;
    color: #303644;
    font-size: 12px;
    font-weight: 700;
  }

  .signup-page .signup-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;

    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 12px;

    border: 1px solid var(--signup-border);
    border-radius: 11px;
    background: #fff;

    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .signup-page .signup-input-wrap:focus-within {
    border-color: var(--signup-red);
    box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.08);
  }

  .signup-page .signup-input-wrap > i {
    flex-shrink: 0;
    color: #8993a3;
    font-size: 14px;
  }

  .signup-page .signup-input-wrap input {
    flex: 1;
    width: 100%;
    min-width: 0;
    height: 100%;
    padding: 0;

    border: 0 !important;
    border-radius: 0 !important;
    outline: 0;
    background: transparent !important;
    box-shadow: none !important;

    color: var(--signup-text);
    font-family: inherit;
    font-size: 12px;
  }

  .signup-page .signup-input-wrap input::placeholder {
    color: #8993a3;
    opacity: 1;
  }

  /* Validation */
  .signup-page .invalid-feedback {
    font-size: 11px;
  }

  .signup-page .signup-input-wrap .invalid-feedback {
    position: absolute;
    top: calc(100% + 2px);
    left: 0;
  }

  /* Eye icon only — matching login's grey color */
  .signup-page .signup-input-wrap .signup-toggle {
    flex: 0 0 24px;
    width: 24px;
    min-width: 24px;
    height: 36px;
    margin: 0 -4px 0 0;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;

    color: #8993a3 !important;
    cursor: pointer;
    outline: none;
    line-height: 1;

    appearance: none;
    -webkit-appearance: none;
    transition: color 0.2s ease;
  }

  .signup-page .signup-input-wrap .signup-toggle i {
    display: block;
    margin: 0;
    padding: 0;
    color: inherit;
    font-size: 18px;
    line-height: 1;
    pointer-events: none;
  }

  /* Keep the eye grey on hover — not red */
  .signup-page .signup-input-wrap .signup-toggle:hover,
  .signup-page .signup-input-wrap .signup-toggle:active {
    color: #8993a3 !important;
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  .signup-page .signup-toggle:focus {
    outline: none;
  }

  .signup-page .signup-toggle:focus-visible {
    outline: 2px solid rgba(137, 147, 163, 0.4);
    outline-offset: 2px;
  }

  /* Primary button */
  .signup-page .signup-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    width: 100%;
    min-height: 43px;
    margin-top: 4px;
    padding: 9px 14px;

    border: 0;
    border-radius: 12px;
    background: linear-gradient(110deg, #ff4651, #f73543);
    color: #fff;

    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;

    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .signup-page .signup-submit:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 6px 15px rgba(254, 66, 77, 0.2);
  }

  /* Divider */
  .signup-page .signup-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 15px 0;
  }

  .signup-page .signup-divider span {
    flex: 1;
    height: 1px;
    background: #e5e8ef;
  }

  .signup-page .signup-divider p {
    margin: 0;
    color: #8993a3;
    font-size: 10px;
  }

  /* Google button */
  .signup-page .signup-google {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;

    width: 100%;
    min-height: 42px;
    padding: 8px 12px;

    border: 1px solid var(--signup-border);
    border-radius: 12px;
    background: #fff;
    color: #303644;

    font-size: 12px;
    font-weight: 700;
    text-decoration: none;

    transition:
      background 0.2s,
      border-color 0.2s;
  }

  .signup-page .signup-google:hover {
    border-color: #c8cfda;
    background: #898989;
    color: #edeff5;
  }

  .signup-page .signup-google i {
    color: #4285f4;
    font-size: 15px;
  }

  /* Login link */
  .signup-page .signup-login {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 15px;

    color: var(--signup-muted);
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }

  .signup-page .signup-login a {
    color: var(--signup-red);
    font-weight: 700;
    text-decoration: none;
  }

  .signup-page .signup-login a:hover {
    text-decoration: underline;
  }

  /* Security */
  .signup-page .signup-security {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;

    color: #8993a3;
    font-size: 10px;
    text-align: center;
  }

  .signup-page .signup-security i {
    color: #239767;
    font-size: 12px;
  }

  .signup-page a:focus-visible,
  .signup-page button:focus-visible {
    outline: 2px solid rgba(254, 66, 77, 0.5);
    outline-offset: 3px;
  }

  /* Mobile */
  @media (max-width: 575.98px) {
    .signup-page {
      padding: 10px !important;
    }

    .signup-page > .row > .col-12 {
      max-width: 100%;
    }

    .signup-page .signup-card {
      max-width: 100%;
      padding: 20px 17px;
      border-radius: 17px;
    }

    .signup-page .signup-header h1 {
      font-size: 25px;
    }
  }
</style>

<script>
  (() => {
    const form = document.querySelector(".signup-form");
    const passwordInput = document.getElementById("password");
    const togglePassword = document.getElementById("togglePassword");

    if (passwordInput && togglePassword) {
      const eyeIcon = togglePassword.querySelector("i");

      if (eyeIcon) {
        togglePassword.addEventListener("click", () => {
          const showPassword = passwordInput.type === "password";

          passwordInput.type = showPassword ? "text" : "password";

          eyeIcon.classList.toggle("fa-eye", !showPassword);
          eyeIcon.classList.toggle("fa-eye-slash", showPassword);

          togglePassword.setAttribute(
            "aria-label",
            showPassword ? "Hide password" : "Show password",
          );

          togglePassword.setAttribute("aria-pressed", String(showPassword));
        });
      }
    }

    if (form) {
      form.addEventListener("submit", (event) => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }

        form.classList.add("was-validated");
      });
    }
  })();
</script>
