<% layout("/layouts/auth") %>

<div class="container login-page">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="login-card">
        <!-- Header -->
        <div class="login-header">
          <div class="login-icon">
            <i class="fa-regular fa-compass" aria-hidden="true"></i>
          </div>

          <p class="login-eyebrow">WELCOME BACK</p>
          <h1>Welcome Back!</h1>
          <p class="login-subtitle">Log in to your Wanderlust account</p>
        </div>

        <!-- Login Form -->
        <form action="/login" method="POST" class="login-form">
          <div class="login-field">
            <label for="username">Username or Email</label>

            <div class="login-input-wrap">
              <i class="fa-regular fa-user" aria-hidden="true"></i>

              <input
                type="text"
                id="username"
                name="username"
                placeholder="Enter username or email"
                autocomplete="username"
                required
              />
            </div>
          </div>

          <div class="login-field">
            <label for="password">Password</label>

            <div class="login-input-wrap">
              <i class="fa-solid fa-lock" aria-hidden="true"></i>

              <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
                autocomplete="current-password"
                required
              />

              <button
                type="button"
                id="togglePassword"
                class="login-toggle"
                aria-label="Show password"
                aria-controls="password"
                aria-pressed="false"
              >
                Show
              </button>
            </div>
          </div>

          <div class="login-forgot">
            <a href="/forgot-password">Forgot Password?</a>
          </div>

          <button type="submit" class="login-submit">
            <span>Login to Account</span>
            <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </button>
        </form>

        <!-- Divider -->
        <div class="login-divider">
          <span></span>
          <p>OR</p>
          <span></span>
        </div>

        <!-- Google Login -->
        <a href="/auth/google" class="google-login">
          <i class="fa-brands fa-google" aria-hidden="true"></i>
          <span>Continue with Google</span>
        </a>

        <!-- Signup -->
        <p class="login-signup">
          Don't have an account?
          <a href="/signup">Sign up</a>
        </p>

        <!-- Security -->
        <div class="login-security">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          <span>Your next journey starts here.</span>
        </div>
      </div>

      <p class="login-footer">
        WANDERLUST <span>•</span> EXPLORE SOMETHING NEW
      </p>
    </div>
  </div>
</div>

<style>
  /* ===================================
     WANDERLUST COMPACT LOGIN PAGE
  =================================== */

  .login-page,
  .login-page * {
    box-sizing: border-box;
  }

  .login-page {
    --login-red: #fe424d;
    --login-red-dark: #e8323e;
    --login-text: #252832;
    --login-muted: #818b9d;
    --login-border: #dfe4ed;

    position: relative;
    isolation: isolate;
    width: 100%;
    max-width: none;
    min-height: 0 !important;
    height: auto !important;
    margin: 0 !important;
    padding: 12px !important;

    display: flex;
    justify-content: center;
    align-items: flex-start;

    background:
      radial-gradient(
        ellipse at top left,
        rgba(254, 66, 77, 0.07),
        transparent 40%
      ),
      #fffdfd;
  }

  .login-page > .row {
    width: 100%;
    margin: 0;
    justify-content: center;
  }

  .login-page > .row > .col-12 {
    width: 100%;
    max-width: 424px;
    padding: 0;
  }

  /* Card */
  .login-page .login-card {
    width: 100%;
    max-width: 400px;
    min-width: 0;
    min-height: 0 !important;
    height: auto !important;

    margin: 0 auto;
    padding: 20px 24px;

    border: 1px solid #f0edf0;
    border-radius: 20px;
    background: #fff;

    box-shadow: 0 10px 32px rgba(35, 30, 40, 0.07);
  }

  /* Header */
  .login-page .login-header {
    margin: 0 0 20px;
    text-align: center;
  }

  .login-page .login-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 10px;

    display: grid;
    place-items: center;

    border-radius: 50%;
    background: #fff0f1;
    color: var(--login-red);
  }

  .login-page .login-icon i {
    font-size: 23px;
  }

  .login-page .login-eyebrow {
    margin: 0 0 6px;
    color: var(--login-red);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
  }

  .login-page .login-header h1 {
    margin: 0 0 6px;
    color: var(--login-text);
    font-size: 28px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.7px;
  }

  .login-page .login-subtitle {
    margin: 0;
    color: var(--login-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  /* Input fields */
  .login-page .login-field {
    margin-bottom: 13px;
  }

  .login-page .login-field label {
    display: block;
    margin-bottom: 6px;
    color: #303644;
    font-size: 12px;
    font-weight: 700;
  }

  .login-page .login-input-wrap {
    display: flex;
    align-items: center;
    gap: 10px;

    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 12px;

    border: 1px solid var(--login-border);
    border-radius: 11px;
    background: #fff;

    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .login-page .login-input-wrap:focus-within {
    border-color: var(--login-red);
    box-shadow: 0 0 0 3px rgba(254, 66, 77, 0.08);
  }

  .login-page .login-input-wrap > i {
    flex-shrink: 0;
    color: #8993a3;
    font-size: 14px;
  }

  .login-page .login-input-wrap input {
    flex: 1;
    width: 100%;
    min-width: 0;
    height: 100%;
    padding: 0;

    border: 0 !important;
    outline: 0;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;

    color: var(--login-text);
    font-family: inherit;
    font-size: 12px;
  }

  .login-page .login-input-wrap input::placeholder {
    color: #8993a3;
    opacity: 1;
  }

  /* Password toggle */
  .login-page .login-toggle {
    flex-shrink: 0;
    padding: 6px 0 6px 6px;

    border: 0;
    background: transparent;
    color: var(--login-red);

    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
  }

  .login-page .login-toggle:hover {
    color: var(--login-red-dark);
  }

  /* Forgot password */
  .login-page .login-forgot {
    display: flex;
    justify-content: flex-end;
    margin: 0 0 14px;
  }

  .login-page .login-forgot a {
    color: var(--login-red);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .login-page .login-forgot a:hover {
    color: var(--login-red-dark);
    text-decoration: underline;
  }

  /* Login button */
  .login-page .login-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    width: 100%;
    min-height: 43px;
    padding: 9px 14px;

    border: 0;
    border-radius: 12px;
    background: linear-gradient(110deg, #ff4651, #f73543);
    color: #fff;

    font-family: inherit;
    font-size: 13px;
    font-weight: 700;

    cursor: pointer;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .login-page .login-submit:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 6px 15px rgba(254, 66, 77, 0.2);
  }

  .login-page .login-submit i {
    font-size: 14px;
  }

  /* Divider */
  .login-page .login-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 15px 0;
  }

  .login-page .login-divider span {
    flex: 1;
    height: 1px;
    background: #e5e8ef;
  }

  .login-page .login-divider p {
    margin: 0;
    color: #8993a3;
    font-size: 10px;
  }

  /* Google login */
  .login-page a.google-login,
  .login-page a.google-login:link,
  .login-page a.google-login:visited {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;

    width: 100%;
    min-height: 42px;
    padding: 8px 12px;

    border: 1px solid #dfe4ed !important;
    border-radius: 32px !important;
    background: #ffffff !important;
    color: #303644 !important;

    font-family: inherit;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none !important;

    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  /* Google button hover */
  .login-page a.google-login:hover,
  .login-page a.google-login:focus,
  .login-page a.google-login:active {
    background: #8a8a8a !important;
    background-color: #8a8a8a !important;
    border-color: #c8cfda !important;
    color: #ffffff !important;
    text-decoration: none !important;
  }

  .login-page a.google-login:hover span,
  .login-page a.google-login:focus span,
  .login-page a.google-login:active span {
    color: #ffffff !important;
  }

  .login-page a.google-login i {
    color: #4285f4 !important;
    font-size: 15px;
  }

  /* Signup */
  .login-page .login-signup {
    margin: 15px 0 0;
    color: var(--login-muted);
    text-align: center;
    font-size: 12px;
    line-height: 1.5;
  }

  .login-page .login-signup a {
    margin-left: 3px;
    color: var(--login-red);
    font-weight: 700;
    text-decoration: none;
  }

  .login-page .login-signup a:hover {
    text-decoration: underline;
  }

  /* Security message */
  .login-page .login-security {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;

    margin-top: 12px;
    color: #8993a3;
    font-size: 10px;
    text-align: center;
  }

  .login-page .login-security i {
    color: #239767;
    font-size: 12px;
  }

  /* Footer */
  .login-page .login-footer {
    margin: 12px 0 0;
    color: #a1a6b0;
    text-align: center;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .login-page .login-footer span {
    padding: 0 3px;
    color: var(--login-red);
  }

  .login-page a:focus-visible,
  .login-page button:focus-visible {
    outline: 2px solid rgba(254, 66, 77, 0.5);
    outline-offset: 3px;
  }

  /* Mobile */
  @media (max-width: 575.98px) {
    .login-page {
      padding: 10px !important;
    }

    .login-page > .row > .col-12 {
      max-width: 100%;
    }

    .login-page .login-card {
      max-width: 100%;
      padding: 20px 17px;
      border-radius: 17px;
    }

    .login-page .login-header h1 {
      font-size: 25px;
    }
  }
</style>

<script>
  (() => {
    const passwordInput = document.getElementById("password");
    const togglePassword = document.getElementById("togglePassword");

    if (!passwordInput || !togglePassword) return;

    togglePassword.addEventListener("click", () => {
      const showPassword = passwordInput.type === "password";

      passwordInput.type = showPassword ? "text" : "password";
      togglePassword.textContent = showPassword ? "Hide" : "Show";

      togglePassword.setAttribute(
        "aria-label",
        showPassword ? "Hide password" : "Show password",
      );

      togglePassword.setAttribute("aria-pressed", String(showPassword));
    });
  })();
</script>
