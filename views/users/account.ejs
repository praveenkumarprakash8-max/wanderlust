<% layout("/layouts/boilerplate") %>

<div class="row mt-5 mb-5">
  <div class="col-md-6 offset-md-3">
    <div class="card shadow-sm border-0 rounded-4 p-4">
      <div class="text-center mb-4">
        <div
          class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle text-white fw-bold"
          style="
            width: 80px;
            height: 80px;
            font-size: 2rem;
            background: #12372a;
          "
        >
          <%= currUser.username.charAt(0).toUpperCase() %>
        </div>
        <h2 class="fw-bold mb-0">My Account</h2>
      </div>

      <div class="mb-3">
        <label class="form-label text-muted mb-0">Username</label>
        <div class="fw-semibold"><%= currUser.username %></div>
      </div>

      <div class="mb-3">
        <label class="form-label text-muted mb-0">Email</label>
        <div class="fw-semibold"><%= currUser.email %></div>
      </div>

      <div class="mb-4">
        <label class="form-label text-muted mb-0">Sign-in method</label>
        <div class="fw-semibold">
          <%= currUser.googleId ? "Google" : "Username & password" %>
        </div>
      </div>

      <a href="/logout" class="btn btn-outline-secondary w-100">Log out</a>
    </div>
  </div>
</div>
