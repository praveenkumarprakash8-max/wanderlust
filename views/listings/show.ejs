
<% layout("/layouts/boilerplate") -%>

<div class="listing-show-page">

  <div class="show-container">

    <a href="/listings" class="back-link">
      <i class="fa-solid fa-arrow-left"></i> Back to Listings
    </a>

    <!-- Listing Details -->
    <div class="listing-details">

      <div class="listing-image-wrapper">
        <img
          src="<%= listing.image.url %>"
          class="listing-main-img"
          alt="listing_image"
        />
        <span class="image-label">Your next getaway</span>
      </div>

      <div class="listing-info">

        <span class="listing-badge">Featured Stay</span>

        <h1><%= listing.title %></h1>

        <p class="listing-owner">
          <i class="fa-regular fa-user"></i>
          Owned by <strong><%= listing.owner.username %></strong>
        </p>

        <div class="listing-divider"></div>

        <p class="listing-description">
          <%= listing.description %>
        </p>

        <div class="listing-meta">
          <div class="meta-item">
            <i class="fa-solid fa-location-dot"></i>
            <div>
              <span>Location</span>
              <strong><%= listing.location %></strong>
            </div>
          </div>

          <div class="meta-item">
            <i class="fa-solid fa-globe"></i>
            <div>
              <span>Country</span>
              <strong><%= listing.country %></strong>
            </div>
          </div>
        </div>

        <div class="listing-price">
          <span>Price</span>
          <h2>
            &#8377; <%= listing.price.toLocaleString("en-IN") %>
          </h2>
        </div>

        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
          <div class="listing-actions">

            <a
              href="/listings/<%= listing.id %>/edit"
              class="cozy-btn edit-btn"
            >
              <i class="fa-regular fa-pen-to-square"></i> Edit
            </a>

            <form
              method="POST"
              action="/listings/<%= listing.id %>?_method=DELETE"
            >
              <button type="submit" class="cozy-btn delete-btn">
                <i class="fa-regular fa-trash-can"></i> Delete
              </button>
            </form>

          </div>
        <% } %>

      </div>
    </div>

    <!-- Average Rating Calculation -->
    <%
      let totalRating = listing.reviews.reduce(
        (sum, review) => sum + Number(review.rating || 0),
        0
      );

      let averageRating = listing.reviews.length
        ? totalRating / listing.reviews.length
        : 0;
    %>

    <!-- Premium Gold Rating Badge -->
    <div class="listing-average-rating">

      <% if (listing.reviews.length > 0) { %>

        <div class="rating-badge">

          <div class="rating-score">
            <strong><%= averageRating.toFixed(1) %></strong>
            <span class="rating-star">★</span>
            <span class="rating-out-of">/ 5</span>
          </div>

          <span class="rating-label">Excellent</span>

          <small>
            Based on <%= listing.reviews.length %> reviews
          </small>

        </div>

      <% } else { %>

        <div class="rating-badge no-rating">
          <span>No ratings yet</span>
        </div>

      <% } %>

    </div>

    <!-- Reviews Section -->
    <div class="reviews-layout">

      <!-- Leave a Review -->
      <% if (currUser) { %>

        <section class="review-panel">

          <div class="section-heading">
            <span class="heading-icon">
              <i class="fa-regular fa-comment-dots"></i>
            </span>

            <div>
              <h3>Leave a review</h3>
              <p>Share your experience with others.</p>
            </div>
          </div>

          <form
            action="/listings/<%= listing.id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation cozy-review-form"
          >

            <!-- Decimal Rating: 0.5 to 5.0 -->
            <div class="mb-4">

              <label class="form-label">Rating</label>

              <div class="decimal-rating-input">

                <% for (let i = 1; i <= 10; i++) { %>
                  <% let value = i / 2; %>

                  <input
                    type="radio"
                    id="rating-<%= i %>"
                    name="review[rating]"
                    value="<%= value %>"
                    required
                  />

                  <label for="rating-<%= i %>">
                    <%= value.toFixed(1) %>
                  </label>

                <% } %>

              </div>

            </div>

            <!-- Comment -->
            <div class="mb-4">

              <label for="comment" class="form-label">
                Comments
              </label>

              <textarea
                name="review[comment]"
                id="comment"
                rows="5"
                class="form-control cozy-textarea"
                placeholder="Share your experience..."
                required
              ></textarea>

              <div class="invalid-feedback">
                Please enter some comments for reviews
              </div>

            </div>

            <button type="submit" class="cozy-btn submit-review-btn">
              <i class="fa-regular fa-paper-plane"></i>
              Submit Review
            </button>

          </form>
        </section>

      <% } %>

      <!-- All Reviews -->
      <section class="all-reviews-panel">

        <div class="section-heading reviews-title">

          <span class="heading-icon">
            <i class="fa-regular fa-comments"></i>
          </span>

          <div>
            <h3>All Reviews</h3>
            <p>Experiences shared by our guests.</p>
          </div>

          <span class="review-count">
            <%= listing.reviews.length %>
          </span>

        </div>

        <% if (listing.reviews.length > 0) { %>

          <div class="reviews-list">

            <% for (let review of listing.reviews) { %>

              <article class="review-card">

                <div class="review-card-top">

                  <div class="review-avatar">
                    <i class="fa-regular fa-user"></i>
                  </div>

                  <div class="review-author">
                    <h5><%= review.author.username %></h5>
                    <span>Guest review</span>
                  </div>

                </div>

                <!-- Individual Decimal Rating -->
                <div class="individual-review-rating">
                  <strong>
                    <%= Number(review.rating).toFixed(1) %>
                  </strong>
                  <span>★</span>
                  <small>/ 5</small>
                </div>

                <!-- Existing Starability Display -->
                <p
                  class="starability-result review-stars"
                  data-rating="<%= Math.round(Number(review.rating)) %>"
                ></p>

                <p class="review-comment">
                  <%= review.comment %>
                </p>

                <% if (currUser && review.author._id.equals(currUser._id)) { %>

                  <form
                    method="POST"
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                    class="review-delete-form"
                  >

                    <button type="submit" class="review-delete-btn">
                      <i class="fa-regular fa-trash-can"></i>
                      Delete review
                    </button>

                  </form>

                <% } %>

              </article>

            <% } %>

          </div>

        <% } else { %>

          <div class="empty-reviews">
            <i class="fa-regular fa-comments"></i>
            <h4>No reviews yet</h4>
            <p>Be the first to share your experience.</p>
          </div>

        <% } %>

      </section>

    </div>

  </div>
</div>
