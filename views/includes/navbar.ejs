
<style>
  @import url("https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&display=swap");

  .main-navbar {
    position: sticky;
    top: 0;
    z-index: 1030;
    padding: 0.6rem 0;
    background: #fff;
    box-shadow: 0 2px 16px rgba(16, 24, 40, 0.06);
  }

  .main-navbar .container-fluid {
    padding-left: 18px;
    padding-right: 18px;
  }

  .main-navbar .brand-wrap {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: #12314d;
    font-family: "Manrope", sans-serif;
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -1px;
    text-decoration: none;
    white-space: nowrap;
  }

  .main-navbar .brand-wrap:hover {
    color: #12314d;
  }

  .main-navbar .brand-logo {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 39px;
    height: 39px;
    border-radius: 12px;
    background: #1769aa;
    color: #fff;
    font-size: 22px;
    letter-spacing: 0;
  }

  .main-navbar .search-inp {
    min-width: 0;
    padding: 0.5rem 1rem;
    border-radius: 25px;
    font-size: 1rem;
  }

  .main-navbar .search-btn {
    padding: 0 1rem;
    border: 1px solid #1769aa;
    border-radius: 25px;
    background: #fff;
    color: #1769aa;
    white-space: nowrap;
    transition: all 0.25s;
  }

  .main-navbar .search-btn:hover {
    background: #1769aa;
    color: #fff;
  }

  .main-navbar .search-btn i {
    margin-right: 0.5rem;
  }

  .main-navbar .add-listing-btn {
    margin: 0 12px;
    padding: 8px 18px;
    border: 1px solid #1769aa;
    border-radius: 8px;
    background: #1769aa;
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
    transition: all 0.25s ease;
  }

  .main-navbar .add-listing-btn:hover {
    transform: translateY(-2px);
    border-color: #12314d;
    background: #12314d;
    color: #fff;
    box-shadow: 0 4px 12px rgba(18, 49, 77, 0.25);
  }

  .main-navbar .profile-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 2px solid #e3e7ea;
    border-radius: 50%;
    background: #1769aa;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
  }

  .main-navbar .profile-btn:hover,
  .main-navbar .profile-btn:focus,
  .main-navbar .profile-btn.show {
    border-color: #12314d;
    background: #12314d;
    color: #fff;
    box-shadow: 0 4px 12px rgba(18, 49, 77, 0.25);
  }

  .main-navbar .profile-btn::after {
    display: none;
  }

  .main-navbar .profile-menu {
    min-width: 220px;
    padding: 8px;
    border: none;
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(16, 24, 40, 0.16);
  }

  .main-navbar .profile-menu .dropdown-item {
    padding: 10px 14px;
    border-radius: 10px;
    font-weight: 500;
  }

  .main-navbar .profile-menu .dropdown-item:hover {
    background: #f3f6f4;
  }

  .main-navbar .profile-menu .menu-head {
    padding: 8px 14px 10px;
    color: #6b7280;
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }

  /* Desktop/mobile visibility defaults */
  .main-navbar .desktop-navbar {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .main-navbar .mobile-navbar,
  .main-navbar .mobile-search-panel {
    display: none;
  }

  /* Mobile controls */
  .main-navbar .mobile-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    flex-shrink: 0;
  }

  .main-navbar .mobile-icon-btn,
  .main-navbar .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid #dce6ee;
    border-radius: 11px;
    background: #fff;
    color: #1769aa;
    font-size: 17px;
  }

  .main-navbar .mobile-icon-btn:hover,
  .main-navbar .mobile-menu-toggle:hover {
    background: #eef6fc;
  }

  .main-navbar .mobile-add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 10px;
    border: 1px solid #1769aa;
    border-radius: 11px;
    background: #1769aa;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .main-navbar .mobile-add-btn:hover {
    background: #12314d;
    color: #fff;
  }

  .main-navbar .mobile-search-panel {
    padding: 10px 0 2px;
  }

  .main-navbar .mobile-search-panel.is-open {
    display: block;
  }

  .main-navbar .mobile-search-panel form {
    display: flex;
    gap: 8px;
  }

  .main-navbar .mobile-search-panel .search-inp {
    flex: 1;
    width: 100%;
  }

  .main-navbar .mobile-search-panel .search-btn {
    min-height: 42px;
  }

  /* CRITICAL FIX: mobile menu must never show on desktop */
  @media (min-width: 768px) {
    .main-navbar .desktop-navbar {
      display: flex !important;
    }

    .main-navbar .mobile-navbar,
    .main-navbar #mobileNavMenu,
    .main-navbar .mobile-search-panel {
      display: none !important;
    }
  }

  /* Mobile layout */
  @media (max-width: 767.98px) {
    .main-navbar {
      padding: 10px 0;
    }

    .main-navbar > .container-fluid {
      display: block;
      padding-left: 12px;
      padding-right: 12px;
    }

    .main-navbar .desktop-navbar {
      display: none !important;
    }

    .main-navbar .mobile-navbar {
      display: flex !important;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      width: 100%;
    }

    .main-navbar .mobile-navbar .brand-wrap {
      min-width: 0;
      gap: 7px;
      font-size: clamp(16px, 4.5vw, 22px);
      letter-spacing: -0.7px;
    }

    .main-navbar .mobile-navbar .brand-logo {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      font-size: 20px;
    }

    .main-navbar .mobile-search-panel {
      display: none;
    }

    .main-navbar .mobile-search-panel.is-open {
      display: block;
    }

    /* Mobile hamburger menu */
    .main-navbar #mobileNavMenu {
      width: 100%;
      padding: 10px 2px 2px;
    }

    .main-navbar #mobileNavMenu.collapse:not(.show) {
      display: none !important;
    }

    .main-navbar #mobileNavMenu.collapse.show {
      display: block !important;
    }

    .main-navbar #mobileNavMenu .nav-link {
      padding: 12px 10px;
      border-bottom: 1px solid #edf0f3;
      color: #12314d;
      text-decoration: none;
    }

    .main-navbar #mobileNavMenu .profile-btn {
      margin: 10px 0 4px 8px;
    }

    .main-navbar #mobileNavMenu .profile-menu {
      width: 100%;
    }
  }

  @media (max-width: 380px) {
    .main-navbar .container-fluid {
      padding-left: 8px;
      padding-right: 8px;
    }

    .main-navbar .mobile-navbar .brand-wrap {
      gap: 5px;
      font-size: 15px;
    }

    .main-navbar .mobile-navbar .brand-logo {
      width: 32px;
      height: 32px;
      font-size: 18px;
    }

    .main-navbar .mobile-actions {
      gap: 5px;
    }

    .main-navbar .mobile-icon-btn,
    .main-navbar .mobile-menu-toggle {
      flex-basis: 36px;
      width: 36px;
      height: 36px;
    }

    .main-navbar .mobile-add-btn {
      min-height: 36px;
      gap: 4px;
      padding: 0 7px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-navbar .search-btn,
    .main-navbar .add-listing-btn {
      transition: none;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top main-navbar">
  <div class="container-fluid">

    <!-- Desktop navbar -->
    <div class="desktop-navbar">
      <a class="brand-wrap" href="/">
        <span class="brand-logo">W</span>
        <span>Wanderlust</span>
      </a>

      <div class="d-flex align-items-center ms-auto">
        <form class="d-flex" role="search" action="/listings" method="GET">
          <input
            class="form-control me-2 search-inp"
            type="search"
            name="search"
            placeholder="Search destination"
            aria-label="Search destination"
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>

        <a class="btn add-listing-btn" href="/listings/new">Add listing</a>

        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>

        <% if (currUser) { %>
          <div class="dropdown">
            <button
              class="btn profile-btn dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              aria-label="Profile menu"
            >
              <%= currUser.username.charAt(0).toUpperCase() %>
            </button>

            <ul class="dropdown-menu dropdown-menu-end profile-menu">
              <li class="menu-head">
                Signed in as<br /><b><%= currUser.email %></b>
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item" href="/account">
                  <i class="fa-regular fa-user me-2"></i>My Account
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/logout">
                  <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Log out
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Mobile navbar -->
    <div class="mobile-navbar">
      <a class="brand-wrap" href="/">
        <span class="brand-logo">W</span>
        <span>Wanderlust</span>
      </a>

      <div class="mobile-actions">
        <button
          class="mobile-icon-btn"
          type="button"
          id="mobileSearchToggle"
          aria-label="Open search"
          aria-expanded="false"
          aria-controls="mobileSearchPanel"
        >
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>

        <a class="mobile-add-btn" href="/listings/new">
          <i class="fa-solid fa-plus"></i>
          <span>Add</span>
        </a>

        <button
          class="navbar-toggler mobile-menu-toggle"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mobileNavMenu"
          aria-controls="mobileNavMenu"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
      </div>
    </div>

    <!-- Mobile search panel -->
    <div class="mobile-search-panel" id="mobileSearchPanel">
      <form role="search" action="/listings" method="GET">
        <input
          class="form-control search-inp"
          type="search"
          name="search"
          placeholder="Search destination"
          aria-label="Search destination"
        />
        <button class="btn search-btn" type="submit" aria-label="Search">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>
    </div>

    <!-- Mobile-only menu; hidden on desktop -->
    <div class="collapse navbar-collapse" id="mobileNavMenu">
      <div class="navbar-nav ms-auto">
        <% if (!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <% } %>

        <% if (currUser) { %>
          <div class="dropdown">
            <button
              class="btn profile-btn dropdown-toggle"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              aria-label="Profile menu"
            >
              <%= currUser.username.charAt(0).toUpperCase() %>
            </button>

            <ul class="dropdown-menu profile-menu">
              <li class="menu-head">
                Signed in as<br /><b><%= currUser.email %></b>
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class="dropdown-item" href="/account">
                  <i class="fa-regular fa-user me-2"></i>My Account
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/logout">
                  <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Log out
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</nav>

<script>
  (() => {
    const searchToggle = document.getElementById("mobileSearchToggle");
    const searchPanel = document.getElementById("mobileSearchPanel");

    if (searchToggle && searchPanel) {
      searchToggle.addEventListener("click", () => {
        const isOpen = searchPanel.classList.toggle("is-open");

        searchToggle.setAttribute("aria-expanded", String(isOpen));
        searchToggle.setAttribute(
          "aria-label",
          isOpen ? "Close search" : "Open search"
        );

        if (isOpen) {
          const input = searchPanel.querySelector('input[type="search"]');
          if (input) input.focus();
        }
      });
    }
  })();
</script>
